# Copiare in backend/.env. Non caricare .env su GitHub.
APP_ENV=development
APP_ORIGIN=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,api
DATABASE_URL=sqlite:///./inventory.db
SESSION_HOURS=8
# PostgreSQL/Supabase, per produzione (password URL-encoded):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full&sslrootcert=/run/secrets/root.crt
